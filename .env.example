# ---- Environment configuration -------------------------------------------
# Copy to `.env` (server) and `apps/web/.env` (client) as documented in README.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite is the zero-setup default. PostgreSQL is fully supported:
#   1. set DATABASE_URL to a postgres:// url
#   2. run `pnpm db:use-postgres` then `pnpm db:generate && pnpm db:migrate`
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Public origin of the web app (used for CORS + password reset links)
APP_URL="http://localhost:5173"
# 32+ byte random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="dev-only-insecure-secret-change-me-0123456789abcdef0123456789abcdef"
# Session + password-reset token lifetimes
SESSION_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=60
# Comma separated list of allowed browser origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Directory (relative to packages/server) where uploads are written
UPLOAD_DIR="uploads"
# Set to "true" to expose the reset link in the API response (dev/demo only)
EXPOSE_RESET_TOKEN=true

# ---------------------------------------------------------------------------
# Web client (apps/web/.env)
# ---------------------------------------------------------------------------
VITE_API_URL="http://localhost:4000"
VITE_WS_URL="ws://localhost:4000/ws"
