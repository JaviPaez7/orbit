# ---------------------------------------------------------------------------
# Orbit — production image (API only; the static client is built separately and
# served from a distroless/nginx or the repo's own web build).
#
# Build context is the repository root:
#   docker build -f deploy/Dockerfile.api -t orbit-api .
# ---------------------------------------------------------------------------

# ---- build -----------------------------------------------------------------
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV CI=true

RUN corepack enable && corepack prepare pnpm@10 --activate

# Install first so the layer is cached across source-only changes. The root
# workspace manifest is included so `pnpm install` resolves the same graph as CI.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY apps/e2e/package.json apps/e2e/
RUN pnpm install --frozen-lockfile

# Build the shared contracts package and the API.
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/server apps/server
RUN pnpm --filter @orbit/shared build && pnpm --filter @orbit/server build

# ---- runtime ---------------------------------------------------------------
FROM node:22-bookworm-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=4000

RUN corepack enable && corepack prepare pnpm@10 --activate && apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/*

# Dependencies (Prisma CLI + Client live here) and the compiled output.
COPY --from=build /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared/package.json packages/shared/
COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY --from=build /app/apps/server/package.json apps/server/
COPY --from=build /app/apps/server/dist apps/server/dist

# Prisma assets: both schemas (the entrypoint selects PostgreSQL), both
# migration sets and the seed.
COPY apps/server/prisma apps/server/prisma
COPY apps/server/scripts apps/server/scripts
COPY apps/server/prisma.config.ts apps/server/prisma.config.ts
COPY deploy/docker-entrypoint.sh /usr/local/bin/orbit-entrypoint.sh
RUN chmod +x /usr/local/bin/orbit-entrypoint.sh && mkdir -p apps/server/uploads

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${PORT}/health" || exit 1

ENTRYPOINT ["/usr/local/bin/orbit-entrypoint.sh"]
CMD ["node", "apps/server/dist/index.js"]
