# ---------------------------------------------------------------------------
# Orbit — production API image.
#
# Build context is the REPOSITORY ROOT (see deploy/docker-compose.prod.yml):
#   docker build -f deploy/Dockerfile.api -t orbit-api .
#
# The static client is built separately (`pnpm --filter @orbit/web build`) and
# served by the `web` service in the compose stack.
# ---------------------------------------------------------------------------

# ---- build -----------------------------------------------------------------
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV CI=true

# Install first so the layer is cached across source-only changes. The root
# workspace manifest is included so `pnpm install` resolves the same graph as CI.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# The pnpm version comes from `packageManager` in package.json, so the image and
# CI always agree. A mismatch makes pnpm reinstall the workspace at runtime.
RUN corepack enable && corepack prepare --activate
COPY packages/shared/package.json packages/shared/
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY apps/e2e/package.json apps/e2e/
RUN pnpm install --frozen-lockfile

# Build the shared contracts package and the API.
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/server apps/server

# The API is compiled against the PostgreSQL client: workflow columns are native
# enums and JSON columns are `Json`, so the generated types differ from the
# SQLite default. Generating here keeps the shipped client and the compiled code
# in agreement. DATABASE_URL is only needed by the schema loader, never to build.
ENV DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build?schema=public"
RUN cp apps/server/prisma/schema.postgres.prisma apps/server/prisma/schema.prisma \
 && pnpm --filter @orbit/server exec prisma generate \
 && pnpm --filter @orbit/shared build \
 && pnpm --filter @orbit/server build

# ---- runtime ---------------------------------------------------------------
FROM node:22-bookworm-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=4000

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/*

# Dependencies and the compiled output. The per-package node_modules are pnpm
# symlinks into the root store: they are what resolves `@orbit/shared` and the
# Prisma/tsx binaries, so the container never needs pnpm or the network.
COPY --from=build /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared/package.json packages/shared/
COPY --from=build /app/packages/shared/node_modules packages/shared/node_modules
COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY --from=build /app/apps/server/package.json apps/server/
COPY --from=build /app/apps/server/node_modules apps/server/node_modules
COPY --from=build /app/apps/server/dist apps/server/dist

# Prisma assets: both schemas (the entrypoint selects PostgreSQL), both
# migration sets and the seed.
COPY apps/server/prisma apps/server/prisma
COPY apps/server/scripts apps/server/scripts
COPY apps/server/prisma.config.ts apps/server/prisma.config.ts
COPY deploy/docker-entrypoint.sh /usr/local/bin/orbit-entrypoint.sh
RUN chmod +x /usr/local/bin/orbit-entrypoint.sh && mkdir -p apps/server/uploads

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${PORT}/health" || exit 1

ENTRYPOINT ["/usr/local/bin/orbit-entrypoint.sh"]
CMD ["node", "apps/server/dist/index.js"]
