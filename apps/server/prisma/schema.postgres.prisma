// ---------------------------------------------------------------------------
// Orbit — Prisma schema (PostgreSQL variant)
//
// Generated/maintained in lock-step with `schema.prisma` (SQLite). Differences
// are limited to:
//   * datasource provider: postgresql
//   * workflow columns use native PostgreSQL enums instead of short strings
//   * JSON-encoded string columns become Json / String[]
//
// Switch with:  pnpm db:use-postgres
// Regenerate:   pnpm db:generate && pnpm db:migrate
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  owner
  admin
  member
  viewer
}

enum MemberStatus {
  active
  suspended
}

enum IssueStatus {
  backlog
  todo
  in_progress
  in_review
  done
  cancelled
}

enum IssuePriority {
  none
  low
  medium
  high
  urgent
}

enum ProjectStatus {
  planned
  in_progress
  paused
  completed
  cancelled
}

enum CycleStatus {
  upcoming
  active
  completed
}

enum IssueRelationType {
  related
  blocks
  blocked_by
  duplicate
}

enum ActivityEntityType {
  issue
  project
  cycle
  workspace
  comment
  member
  label
}

enum ActivityAction {
  created
  updated
  deleted
  status_changed
  priority_changed
  assignee_changed
  project_changed
  cycle_changed
  estimate_changed
  due_date_changed
  title_changed
  description_changed
  label_added
  label_removed
  commented
  comment_updated
  comment_deleted
  relation_added
  relation_removed
  attachment_added
  attachment_removed
  parent_changed
  member_added
  member_removed
  role_changed
  archived
}

enum NotificationType {
  issue_assigned
  issue_unassigned
  issue_status_changed
  issue_comment
  comment_mention
  issue_priority_changed
  issue_due_soon
  workspace_invite
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  handle       String  @unique
  name         String
  passwordHash String
  avatarUrl    String?
  title        String?
  timezone     String?
  deactivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     WorkspaceMember[]
  ownedWorkspaces Workspace[]        @relation("WorkspaceOwner")
  createdIssues   Issue[]            @relation("IssueCreator")
  assignedIssues  Issue[]            @relation("IssueAssignee")
  comments        Comment[]
  activities      Activity[]
  notifications   Notification[]
  sessions        Session[]
  resetTokens     PasswordResetToken[]
  projectLead     Project[]          @relation("ProjectLead")
  projectMembers  ProjectMember[]
  uploadedFiles   Attachment[]

  @@index([email])
  @@index([handle])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Workspaces & permissions
// ---------------------------------------------------------------------------

model Workspace {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  key         String
  description String?
  logoColor   String?
  ownerId     String
  owner       User    @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  issueCounter Int @default(0)
  pendingInvites Json @default("[]")
  archived     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       WorkspaceMember[]
  projects      Project[]
  issues        Issue[]
  labels        Label[]
  cycles        Cycle[]
  activities    Activity[]
  notifications Notification[]

  @@index([slug])
  @@index([ownerId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(member)
  status      MemberStatus  @default(active)
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id          String  @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  icon        String  @default("box")
  color       String  @default("#6366f1")
  status      ProjectStatus @default(planned)
  leadId      String?
  lead        User?   @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  startDate   DateTime?
  targetDate  DateTime?
  archived    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   ProjectMember[]
  issues    Issue[]
  cycles    Cycle[]
  activities Activity[]

  @@index([workspaceId, status])
  @@index([leadId])
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Issues
// ---------------------------------------------------------------------------

model Issue {
  id          String  @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  identifier  String
  number      Int
  title       String
  description String?
  status      IssueStatus   @default(backlog)
  priority    IssuePriority @default(none)
  boardOrder  Float   @default(1000)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  cycleId   String?
  cycle     Cycle?   @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId  String
  creator    User    @relation("IssueCreator", fields: [creatorId], references: [id])

  parentId String?
  parent   Issue?  @relation("SubIssues", fields: [parentId], references: [id], onDelete: SetNull)
  children Issue[] @relation("SubIssues")

  estimate Int?
  dueDate  DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  labels       IssueLabel[]
  comments     Comment[]
  activities   Activity[]
  attachments  Attachment[]
  notifications Notification[]
  relationsFrom IssueRelation[] @relation("RelationSource")
  relationsTo   IssueRelation[] @relation("RelationTarget")

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([workspaceId, priority])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, createdAt])
  @@index([projectId, status])
  @@index([cycleId])
  @@index([assigneeId])
  @@index([creatorId])
  @@index([parentId])
  @@index([identifier])
  @@index([dueDate])
}

model IssueRelation {
  id            String @id @default(cuid())
  issueId       String
  issue         Issue  @relation("RelationSource", fields: [issueId], references: [id], onDelete: Cascade)
  relatedIssueId String
  relatedIssue  Issue  @relation("RelationTarget", fields: [relatedIssueId], references: [id], onDelete: Cascade)
  type          IssueRelationType @default(related)
  createdAt     DateTime @default(now())

  @@unique([issueId, relatedIssueId, type])
  @@index([relatedIssueId])
}

model Label {
  id          String @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  color       String @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  issues IssueLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model IssueLabel {
  issueId   String
  issue     Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  labelId   String
  label     Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([issueId, labelId])
  @@index([labelId])
}

model Comment {
  id        String  @id @default(cuid())
  issueId   String
  issue     Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([issueId, createdAt])
  @@index([authorId])
}

model Attachment {
  id        String  @id @default(cuid())
  issueId   String
  issue     Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploaderId String?
  uploader  User?   @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  filename  String
  url       String
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())

  @@index([issueId])
}

// ---------------------------------------------------------------------------
// Cycles
// ---------------------------------------------------------------------------

model Cycle {
  id          String  @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  number      Int
  startDate   DateTime
  endDate     DateTime
  status      CycleStatus @default(upcoming)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues     Issue[]
  activities Activity[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([startDate])
}

// ---------------------------------------------------------------------------
// Activity, notifications
// ---------------------------------------------------------------------------

model Activity {
  id          String  @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  entityType  ActivityEntityType
  entityId    String
  action      ActivityAction
  entityLabel String?
  issueId     String?
  issue       Issue?  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cycleId     String?
  cycle       Cycle?  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  changes     Json    @default("{}")
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([issueId, createdAt])
  @@index([projectId, createdAt])
  @@index([actorId])
}

model Notification {
  id          String  @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String?
  issueId     String?
  issue       Issue?  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actorId     String?
  actorName   String?
  actorAvatar String?
  data        Json    @default("{}")
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([workspaceId])
}
